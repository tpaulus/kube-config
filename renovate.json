{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "github>tpaulus/renovate-config:auto-merge-gh-actions"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "kubernetes": {
    "managerFilePatterns": [
      "/\\.yaml$/"
    ]
  },
  "argocd": {
    "managerFilePatterns": [
      "/argocd/applications/.+\\.yaml$/"
    ]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^argocd/applications/immich\\.yaml$/"
      ],
      "matchStrings": [
        "image:[ \\t]*\\n[ \\t]+tag:[ \\t]*(?<currentValue>v\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "ghcr.io/immich-app/immich-server",
      "datasourceTemplate": "docker"
    }
  ],
  "platformAutomerge": true,
  "automergeType": "branch",
  "ignoreTests": true,
  "packageRules": [
    {
      "matchManagers": [
        "kubernetes",
        "argocd",
        "dockerfile",
        "custom.regex"
      ],
      "major": {
        "automerge": false
      },
      "minor": {
        "automerge": true
      },
      "patch": {
        "automerge": true
      },
      "minimumReleaseAge": "1 day",
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "matchPackageNames": [
        "netboxcommunity/netbox"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": false
    }
  ],
  "hostRules": [
    {
      "hostType": "docker",
      "matchHost": "ghcr.io",
      "username": "tpaulus",
      "token": "{{ secrets.tpaulus_ghcr }}"
    }
  ]
}
